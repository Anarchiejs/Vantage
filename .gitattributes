# Auto detect text files and perform LF normalization
* text=auto

# Fixtures and expected results are compared byte for byte: they stay LF
# on Windows too, otherwise core.autocrlf turns them into CRLF at checkout and tests fail.
**/testdata/** text=auto eol=lf
internal/sql/queries_test/expected/** text=auto eol=lf
internal/sql/queries/PLANS.md text eol=lf

# Windows scripts: CRLF, required by cmd.exe and PowerShell 5.1.
*.cmd text eol=crlf
*.ps1 text eol=crlf
