# Auto detect text files and perform LF normalization
* text=auto

# Les fixtures et les résultats attendus sont comparés octet par octet : ils restent en LF
# sous Windows aussi, sinon core.autocrlf les convertit en CRLF au checkout et les tests échouent.
**/testdata/** text=auto eol=lf
internal/sql/requetes_test/attendu/** text=auto eol=lf
internal/sql/requetes/PLANS.md text eol=lf

# Scripts Windows : CRLF, attendu par cmd.exe et PowerShell 5.1.
*.cmd text eol=crlf
*.ps1 text eol=crlf
